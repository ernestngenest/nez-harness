{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "environment": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "browseract": {
      "type": "remote",
      "url": "https://mcp.browseract.com/101386126929409077/mcp/",
      "headers": {
        "Authorization": "Bearer {env:BROWSERACT_TOKEN}"
      }
    }
  }
}
